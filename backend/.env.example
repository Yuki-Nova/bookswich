# bookswich 后端配置示例。复制为 .env 后填写真实值。
# 数据目录（相对 backend/ 或绝对路径）
DATA_DIR=../data
# MinerU 云 API（解析用，https://mineru.net 申请）
MINERU_API_KEY=
MINERU_BASE_URL=
# 解析分批大小（页/批，默认 25）
# PARSE_BATCH_SIZE=25
# 每日优先解析页数（默认 1000，页内走优先队列快；超出进普通队列排队慢）
# DAILY_QUOTA_PAGES=1000
# 每日文件数上限（默认 5000，一份 PDF 无论多少页均按 1 份计，硬上限）
# DAILY_FILE_LIMIT=5000
# Obsidian vault 根目录（配置后前端出现「导入 Obsidian」按钮，教材自动放入 <vault>/教材/<书名>/）
OBSIDIAN_VAULT_DIR=
# 阿里云 OSS（可选增强：图片转 OSS 外链，vault 只存文本。配置后导出/导入支持 images=oss 模式）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hangzhou
# 图片公网 URL 前缀（空则自动拼 https://<bucket>.<region>.aliyuncs.com/；配 CDN 后改此值）
OSS_IMAGE_BASE_URL=
# 服务器与桶同地域部署时设为 true，走内网 endpoint 免公网下行流量费
OSS_INTERNAL=false
